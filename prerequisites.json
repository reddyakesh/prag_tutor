    "prerequisites": {
      "unit": 1,
      "prerequisites": [
        {
          "topic": "Basic Computer Fundamentals",
          "description": "Understanding of computers, input/output devices, memory, and how computers communicate with external devices."
        },
        {
          "topic": "Data and Information",
          "description": "Understanding of data, information, text, numbers, images, audio, and video, and how information can be represented digitally."
        },
        {
          "topic": "Binary and Bits",
          "description": "Understanding of bits (0 and 1), bytes, binary numbers, and basic binary representation of data."
        },
        {
          "topic": "Basic Data Communication",
          "description": "Understanding the basic idea of sending data from a sender to a receiver through a transmission medium."
        },
        {
          "topic": "Communication Devices",
          "description": "Basic familiarity with computers, printers, routers, switches, hubs, bridges, gateways, and other network-connected devices."
        },
        {
          "topic": "Transmission Media",
          "description": "Basic awareness of wired and wireless communication media such as twisted-pair cable, coaxial cable, fiber-optic cable, and radio waves."
        },
        {
          "topic": "Network Basics",
          "description": "Understanding of nodes, links, connections, and the basic purpose of a computer network."
        },
        {
          "topic": "Network Topology Basics",
          "description": "Basic familiarity with bus, ring, star, mesh, and hybrid network topologies."
        },
        {
          "topic": "LAN, MAN and WAN",
          "description": "Basic understanding of Local Area Network, Metropolitan Area Network, and Wide Area Network and their geographic coverage."
        },
        {
          "topic": "Communication Direction",
          "description": "Understanding of simplex, half-duplex, and full-duplex communication."
        },
        {
          "topic": "Protocols",
          "description": "Understanding that communication between network devices follows a defined set of rules or protocols."
        },
        {
          "topic": "OSI/TCP-IP Layer Awareness",
          "description": "Basic understanding that network communication is divided into layers, especially the physical, data link, network, transport, and application layers."
        },
        {
          "topic": "Frames and Packets",
          "description": "Basic understanding of how data is encapsulated into frames and packets during network communication."
        },
        {
          "topic": "Sender and Receiver Concepts",
          "description": "Understanding the roles of sender, receiver, transmission channel, acknowledgments, and data transfer."
        },
        {
          "topic": "Basic Error Concepts",
          "description": "Understanding that data can be lost, corrupted, duplicated, or received incorrectly during transmission."
        },
        {
          "topic": "Basic Timing Concepts",
          "description": "Understanding delay, transmission time, acknowledgment, timeout, and the basic idea of waiting for a response."
        },
        {
          "topic": "Basic Mathematical Concepts",
          "description": "Comfort with simple arithmetic, powers of 2, modulo arithmetic, and numerical ranges."
        },
        {
          "topic": "Sequence Numbers",
          "description": "Basic understanding of numbering data frames so that the sender and receiver can identify frames and their order."
        },
        {
          "topic": "Acknowledgment (ACK)",
          "description": "Understanding that a receiver can send an acknowledgment to indicate successful receipt of data."
        },
        {
          "topic": "Buffering",
          "description": "Basic understanding of buffers and why a receiver may temporarily store incoming data before processing it."
        }
      ],
      "next_topics": []
    },
